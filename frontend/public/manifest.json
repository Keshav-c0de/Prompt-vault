{
  "manifest_version": 3,
  "name": "AI Prompt Vault",
  "description": "One-click access to your favorite AI prompts.",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "prompt-vault@prompt-vault.dev",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "https://www.prompt-vault.dev/*"],
      "js": ["contentBridge.js"]
    }
  ]
}
